<script>
var SRC='<!DOCTYPE html>\n'+document.documentElement.outerHTML;
/* CONFIGURACION: si tienes un proxy propio, pon su direccion en API_URL. Si no, la app pide tu clave en Ajustes. */
var CONFIG={API_URL:"",ACCESS_CODE:"",MODEL:"claude-sonnet-5-5"};
var mem={};
var st={get:function(k){try{return localStorage.getItem('mtg2:'+k)}catch(e){return mem[k]||null}},set:function(k,v){try{localStorage.setItem('mtg2:'+k,v)}catch(e){mem[k]=v}}};
var CATS={alimento:['🍎','Alimentos'],bebida:['🥤','Bebidas'],limpieza:['🧽','Limpieza'],higiene:['🧴','Higiene'],hogar:['🏠','Hogar'],mascota:['🐾','Mascotas'],bebe:['👶','Bebé'],otro:['📦','Otros']};
