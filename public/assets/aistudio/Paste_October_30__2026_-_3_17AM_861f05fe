function sopts(sel){return Object.keys(SUBS).map(function(k){return '<option value="'+k+'"'+(k===sel?' selected':'')+'>'+SUBS[k]+'</option>'}).join('')}
function guessSub(l){var n=norm(l);if(/panalera/.test(n))return'utensilios';if(/toallit|cambiador|crema/.test(n))return'toallitas';if(/panal/.test(n))return'panales';if(/biberon|formula|papilla|cereal|compota/.test(n))return'alimentacion';if(/champu|shampoo|jabon|talco|colonia|banera|toalla|aceite/.test(n))return'bano';if(/ropa|body|media|gorro|pijama|manta|sabana|zapat/.test(n))return'ropa';return'utensilios'}
function guess(l){var n=norm(l);if(/panal|biberon|chupete|formula infantil|leche de formula|papilla|toallitas|mordedor|babero|bebe/.test(n))return'bebe';
  if(/perro|gato|mascota|dog|cat chow/.test(n))return'mascota';
  if(/champu|shampoo|jabon|pasta dental|cepillo|papel higienico|desodorante|toalla sanitaria|crema/.test(n))return'higiene';
  if(/cloro|detergente|suavizante|desinfectante|fregador|escoba|limpiador|lavaplatos/.test(n))return'limpieza';
